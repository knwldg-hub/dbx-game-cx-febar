{
  "datasets": [
    {
      "asset_name": "mg_aws_serverless_workspace_catalog.game_cx_players.mv_player_trust_safety",
      "catalog": "mg_aws_serverless_workspace_catalog",
      "displayName": "Trust & Safety metrics",
