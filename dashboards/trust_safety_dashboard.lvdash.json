    },
    {
      "catalog": "mg_aws_serverless_workspace_catalog",
      "displayName": "Moderation queue",
      "name": "ds_moderation",
      "queryLines": [
        "SELECT player_id, ROUND(fraud_risk_score, 3) AS fraud_risk_score,\n",
        "       ROUND(COALESCE(toxicity_score, 0), 3) AS toxicity_score,\n",
        "       recommended_action,\n",
        "       ROUND(lifetime_spend_usd, 2) AS lifetime_spend_usd,\n",
        "       reports_received\n",
        "FROM gold_mart_player_360\n",
        "WHERE recommended_action IS NOT NULL\n",
        "ORDER BY fraud_risk_score DESC\n",
        "LIMIT 200"
      ],
      "schema": "game_cx_players"
    }
  ],
